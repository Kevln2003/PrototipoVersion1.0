<Page
    x:Class="PrototipoVersion1._0.Visual.Plantilla.Receta"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrototipoVersion1._0.Visual.Models"
    xmlns:viewmodels="using:PrototipoVersion1._0.Visual.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Receta Médica" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Fecha:" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock Text="{x:Bind ViewModel.FechaReceta, Mode=OneWay}" 
                     FontSize="16" 
                     Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Diagnóstico -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Diagnóstico" FontSize="18" FontWeight="SemiBold"/>
            <TextBox Height="100" 
                    TextWrapping="Wrap" 
                    AcceptsReturn="True"
                    Text="{x:Bind ViewModel.Diagnostico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Ingrese el diagnóstico del paciente"/>
        </StackPanel>

        <!-- Tratamiento -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Botón para agregar nuevo elemento -->
            <Button Content="Agregar Nuevo Rp" 
                    Command="{x:Bind ViewModel.AgregarRpCommand}"
                    Background="#00796B" 
                    Foreground="White"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <!-- Lista de elementos -->
            <ListView x:Name="prescriptionList"
                      ItemsSource="{x:Bind ViewModel.Rp, Mode=OneWay}"
                      Grid.Row="1"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemDeReceta">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Número de item -->
                            <TextBlock Text="{x:Bind IndexNumber, Mode=OneWay}" 
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <!-- Campo de descripción -->
                            <TextBox Grid.Column="1"
                                    Text="{x:Bind Rp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Medicamento y dosis"
                                    Margin="0,0,10,0"/>

                            <!-- Campo de indicaciones -->
                            <TextBox Grid.Column="2"
                                    Text="{x:Bind Indicaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Indicaciones de uso"
                                    Margin="0,0,10,0"/>

                            <!-- Botón eliminar -->
                            <Button Grid.Column="3"
                                    Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Command="{Binding DataContext.EliminarRpCommand, ElementName=prescriptionList}"
                                    CommandParameter="{x:Bind}"
                                    Background="Transparent"
                                    Foreground="Red"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Botón Generar -->
        <Button Grid.Row="3" 
                Content="Generar Receta" 
                Command="{x:Bind ViewModel.GenerarRecetaCommand}"
                Background="Green"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Width="200"/>
    </Grid>
</Page>